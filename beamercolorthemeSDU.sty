% beamercolorthemeSDU.sty — SDU Beamer 颜色主题 / SDU Beamer color theme
% 用法 / Usage: \usecolortheme{SDU}（\usetheme{SDU} 已自动加载）
% 设计基调：白底，山大红只作强调色（frametitle 分隔线、进度条、结构色、block 竖条）
% Design: white background; SDU red acts only as an accent
% (title rule, progress bar, structure color, block side bars)
\mode<presentation>

\RequirePackage{xcolor}

% 主题色：山大红官方定义 CMYK(26,100,100,28)，整套配色围绕它展开。
% 想换强调色：加载主题后执行 \sdusetaccent{<xcolor 颜色>} 即可整体替换。
% Main accent: official SDU red CMYK(26,100,100,28).
% To recolor the whole deck, call \sdusetaccent{<xcolor color>} after \usetheme.
\xdefinecolor{peaking}{cmyk}{0.26,1.0,1.0,0.28}
\newcommand{\sdusetaccent}[1]{%
  \colorlet{peaking}{#1}%
  \setbeamercolor{structure}{fg=peaking}%
  \setbeamercolor{block title}{fg=peaking}%
}

% 辅助色 / Supporting colors
\definecolor{sdudark}{gray}{0.12}   % 章节页底色 / section-page background
\definecolor{sdugray}{gray}{0.94}   % block 浅灰底 / light block background
\definecolor{sdualert}{rgb}{0.72,0.22,0.05}  % alertblock 竖条 / alert bar
\definecolor{sduexample}{rgb}{0.05,0.45,0.28} % exampleblock 竖条 / example bar

% 全局：白底黑字，强调色走 structure
% Global: black on white, accent via structure
\setbeamercolor{normal text}{fg=black!92!white,bg=white}
\setbeamercolor{structure}{fg=peaking}
\setbeamercolor{alerted text}{fg=sdualert}
\setbeamercolor{example text}{fg=sduexample}

% 帧标题与页脚 / Frame title and footline
\setbeamercolor{frametitle}{fg=black!90!white,bg=white}
\setbeamercolor{framesubtitle}{fg=black!55!white}
\setbeamercolor{page number in head/foot}{fg=black!55!white}
\setbeamercolor{footline}{fg=black!55!white,bg=white}

% 标题页 / Title page
\setbeamercolor{title}{fg=black!92!white}
\setbeamercolor{subtitle}{fg=black!55!white}
\setbeamercolor{author}{fg=black!80!white}
\setbeamercolor{institute}{fg=black!55!white}
\setbeamercolor{date}{fg=black!55!white}

% 章节页 / Section pages
\setbeamercolor{section title}{fg=white}

% 块：标题取对应竖条色，标题与正文底统一浅灰，
% 竖条本身由 tcolorbox 在 beamerthemeSDU.sty 里画。
% Blocks: titles take the bar color; title and body share the light gray
% background; the side bar itself is drawn by tcolorbox in beamerthemeSDU.sty.
\setbeamercolor{block title}{fg=peaking,bg=sdugray}
\setbeamercolor{block body}{bg=sdugray}
\setbeamercolor{block title alerted}{fg=sdualert,bg=sdugray}
\setbeamercolor{block body alerted}{bg=sdugray}
\setbeamercolor{block title example}{fg=sduexample,bg=sdugray}
\setbeamercolor{block body example}{bg=sdugray}

% 目录与小部件 / TOC and small items
\setbeamercolor{section in toc}{fg=black!90!white}
\setbeamercolor{subsection in toc}{fg=black!60!white}
\setbeamercolor{item projected}{fg=white,bg=peaking}
\setbeamercolor{caption name}{fg=black!60!white}
\setbeamercolor{bibliography item}{fg=black!60!white}
\setbeamercolor{bibliography entry author}{fg=black!92!white}
\setbeamercolor{bibliography entry title}{fg=black!92!white}
\setbeamercolor{bibliography entry note}{fg=black!60!white}

\mode<all>
