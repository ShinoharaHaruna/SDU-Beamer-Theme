% beamerthemeSDU.sty — 山东大学 Beamer 主题 / SDU Beamer Theme
% 用法 / Usage: \usetheme{SDU}，可选 \usetheme[border]{SDU} 给每页加粗黑边框
%              \usetheme[border]{SDU} draws a thick black border on every page
% 设计语言：白底、左对齐大标题、底部进度条、左竖条 callout、深色章节页
% 参考 Moloch（Metropolis fork）与 Jacquenetta
\mode<presentation>

% ---------- 主题选项 / Theme option ----------
\newif\ifSDU@border
\DeclareOptionBeamer{border}{\SDU@bordertrue}
\ProcessOptionsBeamer

% ---------- 宏包 / Packages ----------
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins}

\RequirePackage{amsmath}
\RequirePackage{booktabs}
\RequirePackage{multicol}
\RequirePackage{latexsym}
\RequirePackage{calligra}
\RequirePackage[normalem]{ulem} % 不接管 \emph，避免与 biblatex 冲突 / keep \emph intact for biblatex

% 代码显示 / Code listings
\RequirePackage{listings}
\definecolor{deepblue}{rgb}{0,0,0.5}
\definecolor{deepred}{rgb}{0.6,0,0}
\definecolor{deepgreen}{rgb}{0,0.5,0}
\definecolor{halfgray}{gray}{0.55}
\lstset{
    basicstyle=\ttfamily\small,
    keywordstyle=\bfseries\color{deepblue},
    emphstyle=\ttfamily\color{deepred},
    stringstyle=\color{deepgreen},
    numbers=left,
    numberstyle=\small\color{halfgray},
    backgroundcolor=\color{black!4},
    frame=none,
    xleftmargin=1em,
}

% 自定义命令 / Custom commands
\def\cmd#1{\texttt{\color{red}\footnotesize $\backslash$#1}}
\def\env#1{\texttt{\color{blue}\footnotesize #1}}

% ---------- 配色 / Colors ----------
\usecolortheme{SDU}

% ---------- Outer theme：无导航条，headline 为空 ----------
% ---------- No navigation bars or symbols -----------
\setbeamertemplate{headline}{}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{sidebar left}{}
\setbeamertemplate{sidebar right}{}

% footline：右下角 X/N 页码 + 底部山大红进度条（压在浅灰轨道上）
% Footline: X/N page number bottom right plus an accent progress bar
% laid over a light gray track at the very bottom edge
\setbeamertemplate{footline}{%
  \hbox to \paperwidth{%
    \hspace*{1em}%
    {\usebeamerfont{page number in head/foot}%
     \usebeamercolor[fg]{page number in head/foot}%
     \raisebox{-0.55ex}{\includegraphics[height=2.2ex]{img/Example/SDU.eps}}%
     \hspace{0.6em}Shandong University}%
    \hfill
    {\usebeamerfont{page number in head/foot}%
     \usebeamercolor[fg]{page number in head/foot}%
     \insertframenumber\,/\,\inserttotalframenumber}%
    \hspace*{1em}%
  }%
  \vskip 3pt%
  \nointerlineskip
  \hbox{%
    {\color{black!12}\rule{\paperwidth}{0.6pt}}%
    \hskip-\paperwidth
    {\color{peaking}%
     \ifnum\inserttotalframenumber>0
       \rule{\dimexpr\paperwidth*\insertframenumber/\inserttotalframenumber\relax}{1.3pt}%
     \fi}%
  }%
}

% ---------- frametitle：左对齐大字 + 下方细分隔线 ----------
\setbeamertemplate{frametitle}{%
  \vskip 1.0em%
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
  \ifx\insertframesubtitle\@empty\else
    \vskip 0.25em%
    {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
  \fi
  \vskip 0.4em%
  {\color{peaking}\rule{\textwidth}{1pt}\par}%
  \vskip 0.1em%
}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize}

% ---------- 标题页：大留白、左对齐 ----------
\setbeamertemplate{title page}{%
  \vfill\vfill
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
  \vskip 0.4em%
  {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
  \vskip 1.4em%
  {\color{peaking}\rule{4em}{1.4pt}\par}%
  \vskip 1.4em%
  {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
  \vskip 0.3em%
  {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}%
  \vskip 0.3em%
  {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
  \vfill
}
\setbeamerfont{title}{size=\huge,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{page number in head/foot}{size=\footnotesize}

% ---------- 左竖条 callout：block / alertblock / exampleblock ----------
% 三种块共用一套视觉语言：左侧粗竖条 + 浅灰底，竖条颜色区分语义。
% All three blocks share one look: thick left bar on a light gray body,
% the bar color marks the semantics (accent / alert / example).
\tcbset{
  sdu callout/.style={
    enhanced,
    sharp corners,
    boxrule=0pt,
    colback=sdugray,
    colframe=sdugray,
    borderline west={2.5pt}{0pt}{#1},
    left=8pt, right=8pt, top=2.5pt, bottom=3.5pt,
    before skip=4pt, after skip=4pt,
  },
}
\tcolorboxenvironment{block}{sdu callout=peaking}
\tcolorboxenvironment{alertblock}{sdu callout=sdualert}
\tcolorboxenvironment{exampleblock}{sdu callout=sduexample}
\setbeamerfont{block title}{series=\bfseries}
\setbeamerfont{block body}{size=\small}
\setbeamerfont{block body alerted}{size=\small}
\setbeamerfont{block body example}{size=\small}

% ---------- 列表 / Lists ----------
\useinnertheme{circles}

% ---------- 章节页：深底 + 幽灵数字 + 白字章节名 ----------
% Section page: dark background, giant ghost number, white section name
\AtBeginSection[]{%
  {%
    \setbeamercolor{background canvas}{bg=sdudark}%
    \setbeamercolor{normal text}{fg=white}%
    \begin{frame}[plain]
      \vfill
      {\color{white!14!sdudark}\fontsize{104}{104}\selectfont\bfseries\thesection\par}%
      \vskip -0.5em%
      {\color{peaking}\rule{3em}{1.4pt}\par}%
      \vskip 0.5em%
      {\fontsize{34}{40}\selectfont\bfseries\color{white}\insertsection\par}%
      \vfill
    \end{frame}%
  }%
}

% ---------- 可选页面边框：\usetheme[border]{SDU} ----------
% Optional page border in the Jacquenetta style, off by default
\ifSDU@border
  \setbeamertemplate{background}{%
    \tikz[overlay]\draw[line width=1.6pt]
      (0.8pt,-0.8pt) rectangle (\paperwidth-0.8pt,-\paperheight+0.8pt);%
  }
\fi

% ---------- 其他模板 / Misc templates ----------
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{caption}[numbered]

\mode<all>
